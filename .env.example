# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3001

# Database (matches docker-compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abrilingo_teacher
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (matches docker-compose defaults)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Resend (email)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@abrilingo.com

# Super-Admin Bootstrap (run once: npm run seed:admin — idempotent)
# SUPER_ADMIN_GOOGLE_ID = the Google account "sub" field (numeric string)
# Find it via https://developers.google.com/oauthplayground or by temporarily
# logging profile.id in src/modules/auth/strategies/google.strategy.ts
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_GOOGLE_ID=your-google-subject-id
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
